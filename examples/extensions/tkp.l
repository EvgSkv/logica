# Autogenerated header for Logica-DuckDB extension tkp.
@Extension("tkp");
ProbConjunction(a, b) = the_logica_value :- the_logica_value == SqlExpr("ProbConjunction({a}, {b})", {a:, b:}), the_logica_value ~ [{facts: [{predicate: Str, args: Str, probability: Num}]}];
TkpTop(proofs, k) = the_logica_value :- the_logica_value == SqlExpr("TkpTop({proofs}, {k})", {proofs:, k:}), the_logica_value ~ [{facts: [{predicate: Str, args: Str, probability: Num}]}];
TkpProbability(v) = the_logica_value :- the_logica_value == SqlExpr("TkpProbability({v})", {v:}), the_logica_value ~ Num;

# Logica-level definitions shipped with the extension.
ArgsString(args) = v :-
  v == SqlExpr("to_json({a})::varchar", {a: args}), v ~ Str;
MakeFact(predicate:, args:, probability:) =
  [{facts: [{predicate:, args: ArgsString(args), probability:}]}];
TKP(x, k) = TkpTop(MergeList(x), k);
